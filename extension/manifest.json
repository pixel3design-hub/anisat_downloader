{
  "manifest_version": 3,
  "name": "AniSat Downloader",
  "version": "0.10.0",
  "description": "Serie, episodi scaricabili, preferiti e feed RSS per animesaturn.net",
  "author": {
    "email": "social@pixel3design.it"
  },
  "homepage_url": "https://github.com/pixel3design-hub/anisat_downloader",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.animesaturn.net/*",
    "*://play.saturncdn.net/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AniSat Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "stream-referer",
        "enabled": true,
        "path": "rules/stream.json"
      }
    ]
  }
}
